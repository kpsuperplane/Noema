#!/usr/bin/env bash
set -euo pipefail

readonly target_os="${1:?target operating system is required}"
readonly target_arch="${2:?target architecture is required}"
readonly destination="${3:?destination directory is required}"
readonly bridge_name="noema-foundation-bridge"

if [[ "${target_os}" != "darwin" ]]; then
  rm -f -- "${destination}/${bridge_name}"
  exit 0
fi

case "${target_arch}" in
  arm64) readonly swift_arch="arm64" ;;
  amd64) readonly swift_arch="x86_64" ;;
  *) echo "unsupported Foundation bridge architecture: ${target_arch}" >&2; exit 1 ;;
esac

readonly repository="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly package="${repository}/bridges/apple-foundation"
swift build --package-path "${package}" --configuration release --arch "${swift_arch}"
readonly bin_path="$(swift build --package-path "${package}" --configuration release --arch "${swift_arch}" --show-bin-path)"
if [[ ! -f "${bin_path}/${bridge_name}" ]]; then
  echo "Swift build did not create ${bridge_name}." >&2
  exit 1
fi
mkdir -p -- "${destination}"
cp -- "${bin_path}/${bridge_name}" "${destination}/${bridge_name}"
chmod 755 "${destination}/${bridge_name}"
