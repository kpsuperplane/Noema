#!/usr/bin/env bash
set -euo pipefail

supervisor="${1:?Noema development supervisor path is required}"

if [[ ! -x "${supervisor}" ]]; then
  echo "Noema development supervisor is not executable: ${supervisor}" >&2
  exit 1
fi

if [[ "$(uname -s)" != "Linux" ]]; then
  exec "${supervisor}" dev
fi

child_pid=""
relay_pid=""
inspection_pid=""
readonly relay_dir="/tmp/noema-codex"
readonly relay_socket="${relay_dir}/graphql.sock"
readonly noema_home="${NOEMA_HOME:-/var/lib/noema-dev}"
readonly backend_socket="${noema_home}/run/graphql.sock"
readonly home_view="${relay_dir}/home"
home_view_mounted=false

if ! command -v bindfs >/dev/null 2>&1; then
  echo "Install bindfs to enable read-only Noema home inspection." >&2
  exit 1
fi
if mountpoint -q -- "${home_view}"; then
  echo "The Noema home inspection view is already mounted: ${home_view}" >&2
  exit 1
fi

cleanup() {
  trap - EXIT HUP INT TERM
  if [[ -n "${inspection_pid}" ]]; then
    kill -TERM "${inspection_pid}" 2>/dev/null || true
    wait "${inspection_pid}" || true
  fi
  if [[ -n "${child_pid}" ]]; then
    kill -TERM "${child_pid}" 2>/dev/null || true
    wait "${child_pid}" || true
  fi
  if [[ -n "${relay_pid}" ]]; then
    kill -TERM "${relay_pid}" 2>/dev/null || true
    wait "${relay_pid}" || true
  fi
  if [[ -S "${relay_socket}" ]]; then
    unlink -- "${relay_socket}"
  fi
  if [[ "${home_view_mounted}" == true ]]; then
    umount -- "${home_view}" || return
    rmdir -- "${home_view}"
  fi
  rmdir -- "${relay_dir}" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' HUP INT TERM

install -d -o root -g root -m 0700 -- "${relay_dir}"
if [[ "$(stat -c '%u:%a' -- "${relay_dir}")" != "0:700" ]]; then
  echo "${relay_dir} must be root-owned with mode 0700" >&2
  exit 1
fi
install -d -o root -g root -m 0700 -- "${home_view}"
# Map ownership in a read-only view without changing service-owned source files.
bindfs -r --force-user=0 --force-group=0 --perms=0000:u=rD --no-allow-other \
  -o attr_timeout=0,entry_timeout=0 "${noema_home}" "${home_view}"
home_view_mounted=true
if [[ -e "${relay_socket}" || -L "${relay_socket}" ]]; then
  if [[ ! -S "${relay_socket}" ]]; then
    echo "${relay_socket} must be a Unix socket" >&2
    exit 1
  fi
  unlink -- "${relay_socket}"
fi
(umask 077; exec systemd-socket-activate \
  --listen="${relay_socket}" \
  --now \
  /usr/lib/systemd/systemd-socket-proxyd "${backend_socket}") &
relay_pid="$!"
for _ in {1..50}; do
  [[ -S "${relay_socket}" ]] && break
  sleep 0.1
done
if [[ ! -S "${relay_socket}" ]]; then
  echo "Noema development GraphQL relay did not start" >&2
  exit 1
fi
chmod 0600 -- "${relay_socket}"
if [[ "$(stat -c '%u:%a' -- "${relay_socket}")" != "0:600" ]]; then
  echo "${relay_socket} must be root-owned with mode 0600" >&2
  exit 1
fi

node "$(dirname -- "${BASH_SOURCE[0]}")/noema-inspection-relay.mjs" \
  "${relay_socket}" "${relay_dir}/inspection-credential.json" &
inspection_pid="$!"

setpriv --pdeathsig TERM setsid "${supervisor}" dev &
child_pid="$!"
wait "${child_pid}"
