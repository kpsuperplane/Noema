#!/usr/bin/env bash
set -euo pipefail

session_name="${NOEMA_TMUX_SESSION:-noema-dev}"
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
supervisor="${repo_dir}/target/noema-dev-launcher/dev-launcher/noema-dev"
guardian="${repo_dir}/scripts/run-noema-dev-supervisor"

if (( EUID == 0 )); then
  noema_home="${NOEMA_HOME:-/var/lib/noema-dev}"
else
  noema_home="${NOEMA_HOME:-.noema-dev}"
fi

if ! command -v tmux >/dev/null 2>&1; then
  echo "attach: tmux is required but was not found in PATH" >&2
  exit 1
fi

if ! tmux has-session -t "=${session_name}" 2>/dev/null; then
  cargo build --manifest-path "${repo_dir}/Cargo.toml" --profile dev-launcher \
    --target-dir "${repo_dir}/target/noema-dev-launcher" -p noema-dev
  if ! tmux new-session -d -s "${session_name}" -c "${repo_dir}" \
    -e "NOEMA_HOME=${noema_home}" "exec ${guardian} ${supervisor}"; then
    tmux has-session -t "=${session_name}"
  fi
fi

if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "=${session_name}"
fi

exec tmux attach-session -t "=${session_name}"
