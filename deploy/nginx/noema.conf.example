# Put these directives in the nginx http block.
limit_req_zone $binary_remote_addr zone=noema_pre_auth:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=noema_connections:10m;
log_format noema '$remote_addr $request_method $uri $status $body_bytes_sent $request_time';

server {
    listen 443 ssl http2;
    server_name noema.example.com;

    ssl_certificate /etc/letsencrypt/live/noema.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/noema.example.com/privkey.pem;

    access_log /var/log/nginx/noema-access.log noema;
    error_log /var/log/nginx/noema-error.log warn;

    client_max_body_size 64k;
    client_header_buffer_size 8k;
    large_client_header_buffers 2 8k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;

    limit_conn noema_connections 20;
    limit_req zone=noema_pre_auth burst=30 nodelay;

    location / {
        proxy_pass http://127.0.0.1:3737;
        proxy_http_version 1.1;
        proxy_set_header Host noema.example.com;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 30s;
    }
}
