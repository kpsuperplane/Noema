{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.noema.a2ui/catalog/v0.9.1",
  "title": "Noema A2UI Catalog",
  "description": "Derived from the A2UI v0.9.1 Basic catalog; media and modal components are intentionally excluded.",
  "catalogId": "com.noema.a2ui/catalog/v0.9.1",
  "components": {
    "Text": {"required": ["component", "text"]},
    "Row": {"required": ["component", "children"]},
    "Column": {"required": ["component", "children"]},
    "Card": {"required": ["component", "child"]},
    "Divider": {"required": ["component"]},
    "Button": {"required": ["component", "child", "action"]},
    "TextField": {"required": ["component", "label"]},
    "CheckBox": {"required": ["component", "label", "value"]},
    "ChoicePicker": {"required": ["component", "options", "value"]}
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {"$ref": "#/components/Text"},
        {"$ref": "#/components/Row"},
        {"$ref": "#/components/Column"},
        {"$ref": "#/components/Card"},
        {"$ref": "#/components/Divider"},
        {"$ref": "#/components/Button"},
        {"$ref": "#/components/TextField"},
        {"$ref": "#/components/CheckBox"},
        {"$ref": "#/components/ChoicePicker"}
      ]
    }
  }
}
