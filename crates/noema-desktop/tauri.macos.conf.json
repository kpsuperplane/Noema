{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noema",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "followsWindowActiveState"
        },
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 30
        }
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "signingIdentity": null
    }
  }
}
