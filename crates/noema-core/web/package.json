{
  "name": "@noema/core-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:schema": "cargo run --manifest-path ../Cargo.toml --bin export_frontend_types",
    "gen:operations": "graphql-codegen --config codegen.ts",
    "gen:types": "bun run gen:schema && bun run gen:operations",
    "dev": "bun run gen:types && vite build --watch",
    "dev:assets": "bun run gen:operations && vite build --watch",
    "dev:tauri": "bun run gen:types && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "bun run gen:types && vite build",
    "build:tauri": "bun run gen:types && vite build --config vite.desktop.config.ts",
    "lint": "bun run gen:types && tsc --noEmit && eslint src --max-warnings=0"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "^12.11.1",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "graphql": "16",
    "graphql-ws": "^6.0.8",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.5",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0"
  }
}
