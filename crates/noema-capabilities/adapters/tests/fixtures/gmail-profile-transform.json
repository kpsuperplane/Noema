{
  "schema_version": 7,
  "definition_id": "definition:fixture_gmail_profile",
  "adapter_id": "fixture_gmail_profile",
  "display_name": "Gmail fixture",
  "definition_revision": "v1",
  "reviewed": true,
  "origin": "https://gmail.googleapis.com/",
  "authentication": {
    "kind": "oauth2_authorization_code_pkce",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
    "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "token_endpoint": "https://oauth2.googleapis.com/token",
    "client_authentication": "client_secret_post",
    "setups": [{
      "callback_mode": "loopback",
      "setup": {
        "credential_type": "Desktop app",
        "setup_url": "https://console.cloud.google.com/apis/credentials",
        "instructions": ["Create a Desktop app OAuth client and download its JSON."],
        "input": {
          "kind": "document",
          "media_type": "application/json",
          "fields": [
            {"id": "client_id", "label": "Client ID"},
            {"id": "client_secret", "label": "Client secret"}
          ],
          "normalize": {
            "language": "luau",
            "source": "return function(input) local d = json.decode(input.document) return { client_id = d.installed.client_id, client_secret = d.installed.client_secret } end"
          }
        }
      }
    }],
    "extra_authorization_parameters": {
      "access_type": "offline",
      "prompt": "consent"
    },
    "account_identity": {
      "operation_id": "get_profile",
      "arguments": {},
      "output_pointer": "/account"
    }
  },
  "operations": [
    {
      "operation_id": "get_profile",
      "description": "Get the authenticated Gmail profile.",
      "method": "GET",
      "path": "/gmail/v1/users/me/profile",
      "fixed_headers": {},
      "arguments": [],
      "behavior": {
        "readOnly": { "value": true, "source": "model" },
        "idempotent": { "value": true, "source": "model" },
        "destructive": { "value": false, "source": "model" },
        "openWorld": { "value": false, "source": "model" }
      },
      "retry": "transport_safe_read",
      "pagination": { "kind": "none" },
      "response": {
        "accepted_content_types": ["application/json"],
        "transform": {
          "language": "luau",
          "source": "return function(response) local profile = json.decode(response.body) return { account = profile.emailAddress, message_count = profile.messagesTotal } end"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "account": { "type": "string", "maxBytes": 256 },
            "message_count": { "type": "integer" }
          },
          "required": ["account", "message_count"],
          "additionalProperties": false
        }
      }
    }
  ]
}
