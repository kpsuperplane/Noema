{
  "schema_version": 9,
  "definition_id": "definition:fixture_gmail_profile",
  "adapter_id": "fixture_gmail_profile",
  "display_name": "Gmail fixture",
  "definition_revision": "v1",
  "reviewed": true,
  "origin": "https://gmail.googleapis.com/",
  "authentication": {
    "kind": "oauth2_authorization_code_pkce",
    "profile_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "operations": [
    {
      "operation_id": "get_profile",
      "description": "Get the authenticated Gmail profile.",
      "method": "GET",
      "path": "/gmail/v1/users/me/profile",
      "authorization": { "kind": "oauth_scopes", "accepted_scope_sets": [["https://www.googleapis.com/auth/gmail.readonly"]] },
      "fixed_headers": {},
      "arguments": [],
      "behavior": {
        "readOnly": { "value": true, "source": "model" },
        "idempotent": { "value": true, "source": "model" },
        "destructive": { "value": false, "source": "model" },
        "openWorld": { "value": false, "source": "model" }
      },
      "retry": "transport_safe_read",
      "pagination": { "kind": "none" },
      "response": {
        "accepted_content_types": ["application/json"],
        "transform": {
          "language": "luau",
          "source": "return function(response) local profile = json.decode(response.body) return { account = profile.emailAddress, message_count = profile.messagesTotal } end"
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "account": { "type": "string", "maxBytes": 256 },
            "message_count": { "type": "integer" }
          },
          "required": ["account", "message_count"],
          "additionalProperties": false
        }
      }
    }
  ]
}
