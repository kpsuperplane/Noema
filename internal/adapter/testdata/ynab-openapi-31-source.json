{
  "openapi": "3.1.1",
  "info": {"title": "YNAB fixture", "version": "1"},
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{"url": "https://api.example.test/"}],
  "components": {
    "schemas": {
      "UpdateMemo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"memo": {"type": "string"}},
        "required": ["memo"]
      }
    }
  },
  "paths": {
    "/v1/budgets/{budget_id}/transactions/{transaction_id}": {
      "patch": {
        "operationId": "transactions/update",
        "parameters": [
          {"name": "budget_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "transaction_id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/UpdateMemo"}}
          }
        },
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
