+package webtool
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestAuditRealBrowserBlocksPrivateNavigation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 60*time.Second)
+	defer cancel()
+	var hits atomic.Int32
+	local := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		_, _ = w.Write([]byte("audit local endpoint"))
+	}))
+	defer local.Close()
+	fixture := newKernelTestFixture(t, "https://unused.example", true)
+	service := fixture.service
+	service.browserPath = "/var/lib/noema-dev/system/tools/obscura/v0.2.2/linux-amd64/obscura"
+	owner := "conversation:audit-network"
+	for _, target := range []string{local.URL, "http://localhost/", "http://[::1]/", "http://10.0.0.1/", "http://169.254.169.254/", "file:///etc/hostname"} {
+		raw, _ := json.Marshal(map[string]any{"url": target})
+		result := service.ExecuteBrowser(ctx, owner, BrowseOpenName, raw, "audit:blocked")
+		if result.Success || !strings.Contains(string(result.Model), "invalid_input") {
+			t.Fatalf("prohibited target result: %s", result.Model)
+		}
+	}
+	if hits.Load() != 0 {
+		t.Fatal("direct private navigation reached endpoint")
+	}
+	opened := service.ExecuteBrowser(ctx, owner, BrowseOpenName, json.RawMessage(`{"url":"https://example.com"}`), "audit:public")
+	if !opened.Success || !strings.Contains(string(opened.Model), "Example Domain") {
+		t.Fatal("public control failed")
+	}
+	session := currentBrowserSession(t, service, owner)
+	// Exercise page-driven navigation in the real worker, below Go input validation.
+	err := session.process.evaluate(ctx, "location.assign("+jsValue(local.URL)+"); true", nil)
+	snapshot := service.ExecuteBrowser(ctx, owner, BrowseSnapshotName, json.RawMessage(`{}`), "audit:after-script")
+	if hits.Load() != 0 {
+		t.Fatal("page-driven private navigation reached endpoint")
+	}
+	if strings.Contains(string(snapshot.Model), "audit local endpoint") {
+		t.Fatal("private page reached model")
+	}
+	t.Logf("six prohibited direct targets rejected; public control passed; page navigation error=%v snapshot_success=%t local_requests=%d", err, snapshot.Success, hits.Load())
+}
