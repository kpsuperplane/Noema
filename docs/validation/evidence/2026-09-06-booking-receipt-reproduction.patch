+package adapter
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+func TestAuditLostBookingResponseReadReceipt(t *testing.T) {
+	var reads, writes atomic.Int64
+	const receipt = "Confirmed booking café 日本語 42"
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path != "/v1/items/booking-42" {
+			t.Error("wrong booking target")
+			w.WriteHeader(400)
+			return
+		}
+		if r.Method == "POST" {
+			writes.Add(1)
+			connection, _, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			_ = connection.Close()
+			return
+		}
+		reads.Add(1)
+		if writes.Load() != 1 {
+			t.Error("receipt does not identify exactly one saved booking")
+		}
+		_ = json.NewEncoder(w).Encode(map[string]string{"name": receipt})
+	}))
+	t.Cleanup(server.Close)
+	previous := http.DefaultTransport
+	transport := previous.(*http.Transport).Clone()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	transport.DialTLSContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		return (&tls.Dialer{Config: &tls.Config{RootCAs: roots, ServerName: "127.0.0.1"}}).DialContext(ctx, network, server.Listener.Addr().String())
+	}
+	http.DefaultTransport = transport
+	t.Cleanup(func() { http.DefaultTransport = previous; transport.CloseIdleConnections() })
+	service, _ := newOAuthService(t, "http://127.0.0.1:3737/adapter/oauth/callback")
+	manifest := testManifest()
+	manifest.Origin = "https://1.1.1.1/"
+	write := manifest.Operations[0]
+	write.OperationID = "write"
+	write.Method = "POST"
+	write.Retry = "never"
+	no := false
+	write.Behavior.ReadOnly.Value = &no
+	write.Behavior.Idempotent.Value = &no
+	manifest.Operations = append(manifest.Operations, write)
+	definition, err := service.files.installDefinition(manifest, "https://example.com/audit", nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = service.Approve(t.Context(), definition.SemanticDigest); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := service.Snapshot()
+	if err != nil || len(snapshot.Connections) != 1 {
+		t.Fatal("setup failed", err)
+	}
+	connection := snapshot.Connections[0]
+	if _, err = service.SaveConnectionPolicy(t.Context(), connection.ConnectionID, "1", 1, "allow_automatically", "always_ask"); err != nil {
+		t.Fatal(err)
+	}
+	bindings, err := service.Bindings()
+	if err != nil || len(bindings) != 2 {
+		t.Fatal("bindings failed", err)
+	}
+	var readBinding, writeBinding Binding
+	for _, binding := range bindings {
+		if binding.OperationID == "lookup" {
+			readBinding = binding
+		} else {
+			writeBinding = binding
+		}
+	}
+	_, ok, err := service.Call(t.Context(), writeBinding, json.RawMessage(`{"id":"booking-42"}`))
+	if ok || !errors.Is(err, ErrOutcomeUncertain) || writes.Load() != 1 {
+		t.Fatalf("write success=%t count=%d uncertain=%t", ok, writes.Load(), errors.Is(err, ErrOutcomeUncertain))
+	}
+	for range 2 {
+		payload, ok, err := service.Call(t.Context(), readBinding, json.RawMessage(`{"id":"booking-42"}`))
+		var result map[string]string
+		if json.Unmarshal(payload, &result) != nil || err != nil || !ok || result["name"] != receipt {
+			t.Fatalf("receipt read success=%t error=%v", ok, err)
+		}
+	}
+	if writes.Load() != 1 || reads.Load() != 2 {
+		t.Fatalf("writes=%d reads=%d", writes.Load(), reads.Load())
+	}
+	t.Log("One saved booking, lost write response, two exact read-only receipts, and no second submission")
+}
