+package webtool
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"net/http"
+	"os"
+	"os/exec"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+type auditNoNetwork struct{ calls int }
+
+func (a *auditNoNetwork) RoundTrip(*http.Request) (*http.Response, error) {
+	a.calls++
+	return nil, errors.New("audit network disabled")
+}
+
+func TestAuditPublicObscuraInstallAndReuse(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 4*time.Minute)
+	defer cancel()
+	service := &Service{obscuraHome: t.TempDir(), endpoints: map[string]string{"obscura": obscuraReleaseURL}}
+	if err := service.PrepareObscura(ctx); err != nil {
+		t.Fatal(err)
+	}
+	path := service.obscuraPath()
+	before, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	output, err := exec.CommandContext(ctx, path, "--version").CombinedOutput()
+	if err != nil {
+		t.Fatalf("installed executable: %v: %s", err, output)
+	}
+	if !strings.Contains(string(output), strings.TrimPrefix(obscuraRelease, "v")) {
+		t.Fatalf("unexpected version: %s", output)
+	}
+	asset, err := obscuraAssetFor(runtime.GOOS, runtime.GOARCH)
+	if err != nil {
+		t.Fatal(err)
+	}
+	offline := &auditNoNetwork{}
+	if err := installObscura(ctx, service.obscuraHome, obscuraReleaseURL, &http.Client{Transport: offline}, asset); err != nil {
+		t.Fatal(err)
+	}
+	if offline.calls != 0 {
+		t.Fatalf("reuse made %d network requests", offline.calls)
+	}
+	after, err := os.ReadFile(service.obscuraPath())
+	if err != nil || sha256.Sum256(before) != sha256.Sum256(after) {
+		t.Fatal("reuse changed executable")
+	}
+	output, err = exec.CommandContext(ctx, path, "--version").CombinedOutput()
+	if err != nil {
+		t.Fatalf("reused executable: %v: %s", err, output)
+	}
+	t.Logf("release=%s platform=%s/%s version=%s executable_sha256=%x offline_requests=%d", obscuraRelease, runtime.GOOS, runtime.GOARCH, strings.TrimSpace(string(output)), sha256.Sum256(after), offline.calls)
+}
