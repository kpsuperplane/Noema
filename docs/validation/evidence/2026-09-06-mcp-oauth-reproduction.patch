+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/kpsuperplane/noema/internal/home"
+	"github.com/kpsuperplane/noema/internal/store"
+	mcpsdk "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestAuditMCPOAuthLifecycle(t *testing.T) {
+	remote := mcpsdk.NewServer(&mcpsdk.Implementation{Name: "audit", Version: "1"}, nil)
+	mcpsdk.AddTool(remote, &mcpsdk.Tool{Name: "lookup"}, func(context.Context, *mcpsdk.CallToolRequest, struct{}) (*mcpsdk.CallToolResult, map[string]any, error) {
+		return nil, map[string]any{"text": "OAuth café 日本語"}, nil
+	})
+	handler := mcpsdk.NewStreamableHTTPHandler(func(*http.Request) *mcpsdk.Server { return remote }, nil)
+	var origin string
+	var exchanges atomic.Int64
+	host := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/.well-known/oauth-protected-resource":
+			json.NewEncoder(w).Encode(map[string]any{"resource": origin, "authorization_servers": []string{origin}})
+		case "/.well-known/oauth-authorization-server":
+			json.NewEncoder(w).Encode(map[string]any{"issuer": origin, "authorization_endpoint": origin + "/authorize", "token_endpoint": origin + "/token", "response_types_supported": []string{"code"}, "code_challenge_methods_supported": []string{"S256"}, "token_endpoint_auth_methods_supported": []string{"none"}})
+		case "/token":
+			exchanges.Add(1)
+			fmt.Fprint(w, `{"access_token":"audit-access","refresh_token":"audit-refresh","token_type":"Bearer","expires_in":3600}`)
+		default:
+			if r.Header.Get("Authorization") != "Bearer audit-access" {
+				w.Header().Set("WWW-Authenticate", `Bearer resource_metadata="`+origin+`/.well-known/oauth-protected-resource"`)
+				w.WriteHeader(401)
+				return
+			}
+			handler.ServeHTTP(w, r)
+		}
+	}))
+	defer host.Close()
+	origin = host.URL
+	paths, _ := home.FromRoot(t.TempDir())
+	db, err := store.Open(t.Context(), paths.Database())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	callback := "http://127.0.0.1:9321/mcp/oauth/callback"
+	service, err := NewService(paths, db, false, nil, callback)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer service.Close()
+	completed := make(chan string, 8)
+	service.SetOAuthCompletionHandler(func(id string) { completed <- id })
+	input := SetupInput{DisplayName: "Audit OAuth", TransportKind: "streamable_http", URL: origin, Secrets: SecretMaterial{Client: &OAuthClient{ClientID: "audit-client"}}}
+	start := func() OAuthAttempt {
+		t.Helper()
+		a, err := service.StartOAuthCreate(t.Context(), "human:local", input, callback)
+		if err != nil {
+			t.Fatal("OAuth start failed", err)
+		}
+		return a
+	}
+	callbackFor := func(a OAuthAttempt) string {
+		t.Helper()
+		u, err := url.Parse(a.AuthorizationURL)
+		if err != nil {
+			t.Fatal("authorization URL invalid")
+		}
+		redirect, err := url.Parse(u.Query().Get("redirect_uri"))
+		if err != nil {
+			t.Fatal("redirect invalid")
+		}
+		q := redirect.Query()
+		q.Set("state", u.Query().Get("state"))
+		q.Set("code", "audit-code")
+		redirect.RawQuery = q.Encode()
+		return redirect.String()
+	}
+	var serverID string
+	t.Run("complete and replay", func(t *testing.T) {
+		a := start()
+		raw := callbackFor(a)
+		if err := service.CompleteOAuth(t.Context(), a.ID, raw); err != nil {
+			t.Fatal(err)
+		}
+		view, err := service.Attempt(t.Context(), a.ID, "human:local")
+		if err != nil || view.Status != "completed" || view.Result == nil {
+			t.Fatal("completion unavailable", err)
+		}
+		serverID = view.Result.Server.ID
+		select {
+		case id := <-completed:
+			if id != a.ID {
+				t.Fatal("wrong completion identity")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("completion missing")
+		}
+		if err := service.CompleteOAuth(t.Context(), a.ID, raw); err == nil {
+			t.Fatal("replay accepted")
+		}
+		if exchanges.Load() != 1 {
+			t.Fatal("callback exchanged more than once")
+		}
+	})
+	if serverID == "" {
+		return
+	}
+	t.Run("cancel", func(t *testing.T) {
+		a := start()
+		raw := callbackFor(a)
+		before := exchanges.Load()
+		service.CancelOAuth(a.ID)
+		if err := service.CompleteOAuth(t.Context(), a.ID, raw); err == nil {
+			t.Fatal("cancelled callback accepted")
+		}
+		view, err := service.Attempt(t.Context(), a.ID, "human:local")
+		if err != nil || view.Status != "failed" || view.Error == "" {
+			t.Fatal("cancel status unavailable", err)
+		}
+		if exchanges.Load() != before {
+			t.Fatal("cancel exchanged token")
+		}
+	})
+	t.Run("renew", func(t *testing.T) {
+		a, err := service.StartOAuthReauthentication(t.Context(), "human:local", serverID, callback)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := service.CompleteOAuth(t.Context(), a.ID, callbackFor(a)); err != nil {
+			t.Fatal(err)
+		}
+		view, err := service.Attempt(t.Context(), a.ID, "human:local")
+		if err != nil || view.Result == nil || view.Result.Server.ID != serverID {
+			t.Fatal("renew changed identity", err)
+		}
+		select {
+		case id := <-completed:
+			if id != a.ID {
+				t.Fatal("wrong renewal completion")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("renewal completion missing")
+		}
+	})
+	t.Run("delete during renewal", func(t *testing.T) {
+		a, err := service.StartOAuthReauthentication(t.Context(), "human:local", serverID, callback)
+		if err != nil {
+			t.Fatal(err)
+		}
+		deleted, err := service.Delete(t.Context(), serverID)
+		if err != nil || !deleted {
+			t.Fatal("delete failed", err)
+		}
+		if err := service.CompleteOAuth(t.Context(), a.ID, callbackFor(a)); err == nil {
+			t.Fatal("deleted connection renewed")
+		}
+		servers, err := service.Servers(t.Context())
+		if err != nil || len(servers) != 0 {
+			t.Fatal("deleted server returned", err)
+		}
+		select {
+		case <-completed:
+			t.Fatal("deleted renewal resumed caller")
+		default:
+		}
+	})
+}
