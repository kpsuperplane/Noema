+package webtool
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/kpsuperplane/noema/internal/provider"
+	"github.com/kpsuperplane/noema/internal/store"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestAuditPublicSearchAndFetch(t *testing.T) {
+	root := t.TempDir()
+	db, err := store.Open(t.Context(), filepath.Join(root, "audit.sqlite3"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	accounts, err := provider.NewAccountService(root, db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = accounts.Initialize(t.Context(), time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	service, err := New(db, accounts, nil, nil, root, "", 2, 1024)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer service.Close()
+	t.Run("public search", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(t.Context(), 25*time.Second)
+		defer cancel()
+		payload, ok := service.Execute(ctx, SearchName, json.RawMessage(`{"query":"IANA example domains","max_results":3}`), "audit:public-search")
+		var result searchResponse
+		if !ok || json.Unmarshal(payload, &result) != nil || len(result.Results) == 0 {
+			t.Fatalf("search failed: %s", payload)
+		}
+		for _, r := range result.Results {
+			if r.Title == "" || !strings.HasPrefix(r.URL, "https://") {
+				t.Fatal("search result lacks title or HTTPS URL")
+			}
+		}
+		t.Logf("search result count=%d", len(result.Results))
+	})
+	t.Run("public fetch", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(t.Context(), 25*time.Second)
+		defer cancel()
+		payload, ok := service.Execute(ctx, FetchName, json.RawMessage(`{"url":"https://example.com/","max_chars":20000}`), "audit:public-fetch")
+		var result fetchResponse
+		if !ok || json.Unmarshal(payload, &result) != nil || result.Title == nil || *result.Title != "Example Domain" || !strings.Contains(result.Content, "documentation examples") || result.URL != "https://example.com/" {
+			t.Fatalf("fetch failed: %s", payload)
+		}
+		t.Logf("fetch source=%s content kind=%s", result.URL, result.ContentKind)
+	})
+}
