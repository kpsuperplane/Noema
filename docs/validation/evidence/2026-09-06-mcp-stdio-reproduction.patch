+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/kpsuperplane/noema/internal/home"
+	"github.com/kpsuperplane/noema/internal/store"
+	mcpsdk "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestAuditMCPStdioAccess(t *testing.T) {
+	if marker := os.Getenv("NOEMA_AUDIT_PROCESS_MARKER"); marker != "" {
+		if err := os.WriteFile(marker, []byte("started"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		server := mcpsdk.NewServer(&mcpsdk.Implementation{Name: "audit", Version: "1"}, nil)
+		mcpsdk.AddTool(server, &mcpsdk.Tool{Name: "check"}, func(_ context.Context, _ *mcpsdk.CallToolRequest, input echoInput) (*mcpsdk.CallToolResult, map[string]any, error) {
+			return nil, map[string]any{"text": input.Text, "ordinary": os.Getenv("NOEMA_AUDIT_ORDINARY"), "credentialBound": os.Getenv("NOEMA_AUDIT_CREDENTIAL") == "synthetic-test-credential", "inheritedAbsent": os.Getenv("NOEMA_AUDIT_PARENT") == ""}, nil
+		})
+		if err := server.Run(context.Background(), &mcpsdk.StdioTransport{}); err != nil {
+			t.Fatal(err)
+		}
+		return
+	}
+	t.Setenv("NOEMA_AUDIT_PARENT", "must-not-cross")
+	paths, err := home.FromRoot(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	db, err := store.Open(t.Context(), paths.Database())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	marker := filepath.Join(t.TempDir(), "started")
+	input := SetupInput{DisplayName: "Audit stdio", TransportKind: "stdio", Command: executable, Args: []string{"-test.run=^TestAuditMCPStdioAccess$"}, Environment: map[string]string{"NOEMA_AUDIT_PROCESS_MARKER": marker, "NOEMA_AUDIT_ORDINARY": "café 日本語"}, Secrets: SecretMaterial{Environment: map[string]string{"NOEMA_AUDIT_CREDENTIAL": "synthetic-test-credential"}}}
+	disabled, err := NewService(paths, db, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer disabled.Close()
+	_, err = disabled.Create(t.Context(), input)
+	if err == nil || !strings.Contains(err.Error(), "disabled") {
+		t.Fatal("disabled setup was accepted")
+	}
+	if _, err = os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatal("disabled setup started process")
+	}
+	servers, err := disabled.Servers(t.Context())
+	if err != nil || len(servers) != 0 {
+		t.Fatal("disabled setup persisted a server")
+	}
+	enabled, err := NewService(paths, db, true, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer enabled.Close()
+	setup, err := enabled.Create(t.Context(), input)
+	if err != nil || setup.Server == nil {
+		t.Fatal("enabled setup failed", err)
+	}
+	if _, err = os.Stat(marker); err != nil {
+		t.Fatal("enabled setup did not start process")
+	}
+	metadata, err := json.Marshal(setup.Server)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(metadata), "synthetic-test-credential") || !strings.Contains(string(metadata), "café 日本語") {
+		t.Fatal("metadata boundary changed")
+	}
+	_, err = enabled.SaveConnectionPolicy(t.Context(), setup.Server.ID, setup.Server.ConnectionRevision, setup.Server.PolicyRevision, "allow_automatically", "always_ask")
+	if err != nil {
+		t.Fatal(err)
+	}
+	bindings, err := enabled.Bindings(t.Context())
+	if err != nil || len(bindings) != 1 {
+		t.Fatal("enabled binding unavailable", err)
+	}
+	payload, ok, err := enabled.Call(t.Context(), bindings[0], json.RawMessage(`{"text":"Stdio café 日本語"}`))
+	if err != nil || !ok {
+		t.Fatal("enabled call failed", err)
+	}
+	var result struct {
+		StructuredContent map[string]any `json:"structuredContent"`
+	}
+	if err = json.Unmarshal(payload, &result); err != nil {
+		t.Fatal(err)
+	}
+	value := result.StructuredContent
+	if value["text"] != "Stdio café 日本語" || value["ordinary"] != "café 日本語" || value["credentialBound"] != true || value["inheritedAbsent"] != true {
+		t.Fatal("child environment or result differs")
+	}
+	secretPath, err := enabled.secrets.connectionPath(setup.Server.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(secretPath)
+	if err != nil || info.Mode().Perm() != 0600 {
+		t.Fatal("credential store permissions differ")
+	}
+}
