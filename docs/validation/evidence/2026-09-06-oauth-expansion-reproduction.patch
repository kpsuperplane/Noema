+package adapter
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+)
+
+func TestAuditOAuthExpandedOperations(t *testing.T) {
+	var scope atomic.Value
+	scope.Store("scope.read")
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.Method == "POST" {
+			fmt.Fprintf(w, `{"access_token":"synthetic-access","refresh_token":"synthetic-refresh","token_type":"Bearer","expires_in":3600,"scope":%q}`, scope.Load().(string))
+			return
+		}
+		fmt.Fprint(w, `{"name":"Expanded café 日本語"}`)
+	}))
+	t.Cleanup(server.Close)
+	previous := http.DefaultTransport
+	transport := previous.(*http.Transport).Clone()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	transport.DialTLSContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		return (&tls.Dialer{Config: &tls.Config{RootCAs: roots, ServerName: "127.0.0.1"}}).DialContext(ctx, network, server.Listener.Addr().String())
+	}
+	http.DefaultTransport = transport
+	t.Cleanup(func() { http.DefaultTransport = previous; transport.CloseIdleConnections() })
+	const callback = "http://127.0.0.1:3737/adapter/oauth/callback"
+	for _, expanded := range []bool{false, true} {
+		name := "partial consent"
+		if expanded {
+			name = "full consent"
+		}
+		t.Run(name, func(t *testing.T) {
+			scope.Store("scope.read")
+			service, _ := newOAuthService(t, callback)
+			application, err := service.ImportOAuthApplication(googleOAuthProfile().ProfileDigest, nil, []byte(`{"installed":{"client_id":"audit-client","client_secret":"synthetic-client"}}`))
+			if err != nil {
+				t.Fatal(err)
+			}
+			manifest := oauthManifest()
+			manifest.Reviewed = true
+			manifest.Origin = "https://1.1.1.1/"
+			manifest.Operations[0].Authorization.AcceptedScopeSets = [][]string{{"scope.read"}}
+			extra := manifest.Operations[0]
+			extra.OperationID = "extra"
+			extra.Authorization.AcceptedScopeSets = [][]string{{"scope.extra"}}
+			manifest.Operations = append(manifest.Operations, extra)
+			definition, err := service.files.installDefinition(manifest, "https://example.com/audit", nil, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			authorize := func(grantID string, revision int, operations []string) OAuthAttemptEvent {
+				t.Helper()
+				attempt, err := service.StartOAuth(OAuthStart{ApplicationID: application.ApplicationID, ExpectedApplicationRevision: application.Revision, SemanticDigest: definition.SemanticDigest, GrantID: grantID, ExpectedGrantRevision: revision, OperationIDs: operations})
+				if err != nil {
+					t.Fatal(err)
+				}
+				parsed, err := url.Parse(attempt.AuthorizationURL)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if grantID != "" && parsed.Query().Get("scope") != "scope.extra scope.read" {
+					t.Error("expanded request omitted required scopes")
+				}
+				query := url.Values{"state": {parsed.Query().Get("state")}, "code": {"synthetic-code"}}
+				event, err := service.CompleteOAuth(t.Context(), callback+"?"+query.Encode())
+				if err != nil || event.Status != "completed" {
+					t.Fatal("authorization failed", err)
+				}
+				return event
+			}
+			initial := authorize("", 0, []string{"lookup"})
+			_, connection, err := service.AttachOAuthConnection(t.Context(), definition.SemanticDigest, initial.GrantID, initial.GrantRevision, "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = service.SaveConnectionPolicy(t.Context(), connection.ConnectionID, "1", 1, "allow_automatically", "always_ask"); err != nil {
+				t.Fatal(err)
+			}
+			before, err := service.Bindings()
+			if err != nil || len(before) != 1 || before[0].OperationID != "lookup" {
+				t.Fatal("initial access is not read-only", err)
+			}
+			if expanded {
+				scope.Store("scope.extra scope.read")
+			}
+			updated := authorize(initial.GrantID, initial.GrantRevision, []string{"lookup", "extra"})
+			if updated.GrantID != initial.GrantID {
+				t.Error("expanded access replaced the account grant")
+			}
+			_, attached, err := service.AttachOAuthConnection(t.Context(), definition.SemanticDigest, updated.GrantID, updated.GrantRevision, "")
+			if err != nil || attached.ConnectionID != connection.ConnectionID {
+				t.Fatal("expanded access replaced connection identity", err)
+			}
+			bindings, err := service.Bindings()
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected := 1
+			if expanded {
+				expected = 2
+			}
+			if len(bindings) != expected {
+				t.Errorf("callable operations=%d expected=%d after consent", len(bindings), expected)
+			}
+			for _, binding := range bindings {
+				if !expanded && binding.OperationID != "lookup" {
+					t.Error("ungranted operation became callable")
+				}
+				payload, ok, err := service.Call(t.Context(), binding, json.RawMessage(`{"id":"record"}`))
+				var value map[string]any
+				_ = json.Unmarshal(payload, &value)
+				if err != nil || !ok || value["name"] != "Expanded café 日本語" {
+					t.Error("granted operation call failed", err)
+				}
+			}
+		})
+	}
+}
