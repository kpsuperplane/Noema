+package store
+
+import (
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestAuditDeletedACPRejectsTaskPlacement(t *testing.T) {
+	ctx := t.Context()
+	now := time.Now()
+	path := filepath.Join(t.TempDir(), "audit.sqlite3")
+	db, err := Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	agent, err := db.CreateAcpAgent(ctx, "Deleted audit ACP", "/missing-audit-acp", nil, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	deleted, err := db.DeleteAcpAgent(ctx, agent.AgentID, agent.ConnectionRevision)
+	if err != nil || !deleted {
+		t.Fatal("delete failed", err)
+	}
+	for _, restart := range []bool{false, true} {
+		if restart {
+			if err = db.Close(); err != nil {
+				t.Fatal(err)
+			}
+			db, err = Open(ctx, path)
+			if err != nil {
+				t.Fatal(err)
+			}
+		}
+		id, err := NewTaskID()
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, err = db.CreateTaskWithOptions(ctx, id, "Rejected ACP Task", testTaskCommand("deleted-create-"+id), TaskCreateOptions{ExecutorAgentID: agent.AgentID}, now)
+		if err == nil {
+			t.Fatal("deleted Executor received a new Task")
+		}
+		if _, err = db.Task(ctx, id); err == nil {
+			t.Fatal("rejected creation left a Task")
+		}
+		task, err := db.CreateTask(ctx, id, "Preserved café 日本語", "correlation:audit:"+id, now)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, err = db.UpdateInboxTask(ctx, id, task.Revision, task.Generation, TaskUpdate{ExecutorAgentID: &agent.AgentID}, testTaskCommand("deleted-update-"+id), now)
+		if err == nil {
+			t.Fatal("deleted Executor received an existing Task")
+		}
+		current, err := db.Task(ctx, id)
+		if err != nil || current.Title != task.Title || current.ExecutorAgentID != task.ExecutorAgentID || current.Revision != task.Revision || current.Generation != task.Generation {
+			t.Fatal("rejected reassignment changed the Task", err)
+		}
+	}
+}
