+package runtime
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAuditPresentationProductionParse(t *testing.T) {
+	const cwd = "/var/tmp/noema-suite-run-20260905/presentations"
+	for _, test := range []struct{ name, want string }{{"audit.ppt", "## First\n\n- **Top**\n\n  - *Child*\n\nTextbox\n\n> Speaker one\n>\n> More\n\n## Outline second\n\n## Second"}, {"audit.pptx", "## Second\n\n> Speaker note\n\n## First"}} {
+		t.Run(test.name, func(t *testing.T) {
+			before, err := os.ReadFile(filepath.Join(cwd, test.name))
+			if err != nil {
+				t.Fatal(err)
+			}
+			args, _ := json.Marshal(map[string]any{"path": test.name, "max_chars": 20000})
+			result, err := parseConversationFile(t.Context(), cwd, args)
+			if err != nil || result.Status != "converted" || result.Content == nil || *result.Content != test.want || result.Truncated {
+				t.Fatalf("parse status=%s exact=%t error=%v", result.Status, result.Content != nil && *result.Content == test.want, err)
+			}
+			after, err := os.ReadFile(filepath.Join(cwd, test.name))
+			if err != nil || string(after) != string(before) {
+				t.Fatal("source changed", err)
+			}
+		})
+	}
+}
