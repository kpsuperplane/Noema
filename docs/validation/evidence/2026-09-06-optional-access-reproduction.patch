+package auth
+
+import (
+	"bytes"
+	"net/http"
+	"os"
+	"testing"
+
+	"github.com/kpsuperplane/noema/internal/home"
+	"github.com/kpsuperplane/noema/internal/mcp"
+)
+
+func TestAuditOptionalAccessFlagsAndPublicAuthority(t *testing.T) {
+	for _, name := range []string{"NOEMA_WEB__GRAPHIQL", "NOEMA_WEB__LOCAL_GRAPHQL_SOCKET", "NOEMA_MCP__STDIO_ENABLED", "NOEMA_WEB__DEV_NO_AUTH"} {
+		t.Setenv(name, "")
+		if err := os.Unsetenv(name); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, tc := range []struct {
+		name, config            string
+		graphiql, socket, stdio bool
+	}{
+		{name: "defaults", config: "{}\n"},
+		{name: "graphiql", config: "web:\n  graphiql: true\n", graphiql: true},
+		{name: "socket", config: "web:\n  local_graphql_socket: true\n", socket: true},
+		{name: "stdio", config: "mcp:\n  stdio_enabled: true\n", stdio: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			paths, err := home.FromRoot(t.TempDir())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := home.AtomicWritePrivate(paths.Config(), []byte(tc.config)); err != nil {
+				t.Fatal(err)
+			}
+			config, _, err := LoadConfig(paths, "127.0.0.1:3737")
+			if err != nil {
+				t.Fatal(err)
+			}
+			stdio, err := mcp.StdioEnabled(paths)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if config.GraphiQL != tc.graphiql || config.LocalGraphQLSocket != tc.socket || stdio != tc.stdio || config.DevNoAuth {
+				t.Fatalf("access flags: graphiql=%t socket=%t stdio=%t devNoAuth=%t", config.GraphiQL, config.LocalGraphQLSocket, stdio, config.DevNoAuth)
+			}
+		})
+	}
+	server, _, _ := newAuthTest(t, false)
+	seedPasskey(t, server, 91)
+	calls := 0
+	handler := server.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls++; w.WriteHeader(http.StatusNoContent) }))
+	request := authRequest(http.MethodPost, "/graphql", bytes.NewBufferString(`{"query":"{__typename}"}`))
+	request.RemoteAddr = "127.0.0.1:12345"
+	request.Header.Set("Forwarded", "for=127.0.0.1;host=localhost;proto=http")
+	request.Header.Set("X-Forwarded-For", "127.0.0.1")
+	request.Header.Set("X-Forwarded-Host", "localhost")
+	request.Header.Set("X-Forwarded-Proto", "http")
+	request.Header.Set("X-Noema-Local", "true")
+	response := serve(handler, request)
+	if response.Code != http.StatusUnauthorized || calls != 0 {
+		t.Fatalf("forged local authority: status=%d calls=%d", response.Code, calls)
+	}
+}
