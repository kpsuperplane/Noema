+package webtool
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestAuditRealBrowserFormReview(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 60*time.Second)
+	defer cancel()
+	fixture := newKernelTestFixture(t, "https://unused.example", true)
+	service := fixture.service
+	service.browserPath = "/var/lib/noema-dev/system/tools/obscura/v0.2.2/linux-amd64/obscura"
+	owner := "conversation:audit-form-review"
+	if result := service.ExecuteBrowser(ctx, owner, BrowseOpenName, json.RawMessage(`{"url":"https://example.com"}`), "audit:open"); !result.Success {
+		t.Fatal("public page open failed")
+	}
+	session := currentBrowserSession(t, service, owner)
+	// These sentinel strings grant no authority and are not actual credentials.
+	script := `document.body.innerHTML='<form action="https://example.com/audit-submit" method="post"><input name="description" value="café 日本語"><input type="hidden" name="hidden_control" value="audit-hidden-sentinel"><input type="password" name="password_control" value="audit-password-sentinel"><input type="file" name="file_control"><button type="submit" name="action" value="send">Send audit</button></form>'; true`
+	if err := session.process.evaluate(ctx, script, nil); err != nil {
+		t.Fatal(err)
+	}
+	result := service.ExecuteBrowser(ctx, owner, BrowseSnapshotName, json.RawMessage(`{}`), "audit:form")
+	if !result.Success {
+		t.Fatal("form snapshot failed")
+	}
+	var snapshot struct {
+		Snapshot browseSnapshot `json:"snapshot"`
+	}
+	if err := json.Unmarshal(result.Stored, &snapshot); err != nil {
+		t.Fatal(err)
+	}
+	var reference string
+	for _, element := range snapshot.Snapshot.Elements {
+		if element.Name == "Send audit" {
+			reference = element.Reference
+		}
+	}
+	if reference == "" {
+		t.Fatal("submit reference missing")
+	}
+	raw := json.RawMessage(fmt.Sprintf(`{"snapshot_revision":%d,"ref":%q,"action":"click"}`, snapshot.Snapshot.Revision, reference))
+	review := service.BrowserActionContext(owner, BrowseInteractName, raw)
+	target, ok := review["target"].(map[string]any)
+	if !ok {
+		t.Fatal("review target missing")
+	}
+	submission, ok := target["submission"].(*browseSubmission)
+	if !ok || submission == nil {
+		t.Fatal("review submission missing")
+	}
+	if submission.Destination != "https://example.com/audit-submit" || strings.ToLower(submission.Method) != "post" {
+		t.Error("review destination or method differs")
+	}
+	values := map[string]string{}
+	for _, field := range submission.Fields {
+		values[field.Name] = field.Value
+	}
+	if len(values) != 2 || values["description"] != "café 日本語" || values["action"] != "send" {
+		t.Error("visible submitted values differ")
+	}
+	if submission.OmittedControlCount != 3 {
+		t.Errorf("omitted controls=%d, want 3", submission.OmittedControlCount)
+	}
+	reviewJSON, err := json.Marshal(review)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, sink := range []struct {
+		name string
+		data []byte
+	}{{"review", reviewJSON}, {"model snapshot", result.Model}, {"stored snapshot", result.Stored}} {
+		for _, sentinel := range []string{"audit-hidden-sentinel", "audit-password-sentinel"} {
+			if strings.Contains(string(sink.data), sentinel) {
+				t.Errorf("protected control value appears in %s", sink.name)
+			}
+		}
+	}
+	t.Log("Form was inspected without submission; visible values and protected-control exclusions were checked")
+}
