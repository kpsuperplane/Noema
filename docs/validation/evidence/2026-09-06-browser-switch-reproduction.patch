+package webtool
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+func TestAuditFailedBrowserSwitchPreservesRoute(t *testing.T) {
+	var fail atomic.Bool
+	fail.Store(true)
+	stub := &kernelTestServer{interaction: func(string) (int, map[string]any) {
+		if fail.Load() {
+			return 503, map[string]any{"success": false, "error": "audit unavailable"}
+		}
+		return 200, kernelTestExecution(200)
+	}}
+	remote := httptest.NewServer(http.HandlerFunc(stub.handler))
+	defer remote.Close()
+	fixture := newKernelTestFixture(t, remote.URL, true)
+	s := fixture.service
+	owner := "task:audit-switch:1"
+	opened := s.ExecuteBrowser(t.Context(), owner, BrowseOpenName, json.RawMessage(`{"url":"https://1.1.1.1/start"}`), "audit:open")
+	if !opened.Success {
+		t.Fatal("initial open failed")
+	}
+	before := currentBrowserSession(t, s, owner)
+	args := json.RawMessage(`{"snapshot_revision":1,"url":"https://8.8.8.8/next"}`)
+	failed := s.ExecuteBrowser(t.Context(), owner, BrowseSwitchName, args, "audit:failed-switch")
+	if failed.Success {
+		t.Fatal("failed provider switch succeeded")
+	}
+	if currentBrowserSession(t, s, owner) != before {
+		t.Fatal("failed switch replaced current session")
+	}
+	current, err := s.BrowserAuthority(t.Context(), owner, BrowseOpenName, json.RawMessage(`{"url":"https://1.1.1.1/start"}`))
+	if err != nil || current.ProviderAccountID != obscuraAccount || current.RoutePosition != 0 {
+		t.Fatal("failed switch changed route", err)
+	}
+	snapshot := s.ExecuteBrowser(t.Context(), owner, BrowseSnapshotName, json.RawMessage(`{}`), "audit:preserved-snapshot")
+	if !snapshot.Success {
+		t.Fatal("old session no longer works")
+	}
+	revision := currentBrowserRevision(t, s, owner)
+	retryArgs, _ := json.Marshal(map[string]any{"snapshot_revision": revision, "url": "https://8.8.8.8/next"})
+	fail.Store(false)
+	switched := s.ExecuteBrowser(t.Context(), owner, BrowseSwitchName, retryArgs, "audit:retry-switch")
+	if !switched.Success {
+		t.Fatalf("retry failed: %s", switched.Model)
+	}
+	after, err := s.BrowserAuthority(t.Context(), owner, BrowseOpenName, json.RawMessage(`{"url":"https://8.8.8.8/next"}`))
+	if err != nil || after.ProviderAccountID != fixture.kernelID || after.RoutePosition != 1 {
+		t.Fatal("retry did not select next provider", err)
+	}
+	if currentBrowserSession(t, s, owner) == before {
+		t.Fatal("successful switch reused prior session")
+	}
+	closed := s.ExecuteBrowser(t.Context(), owner, BrowseCloseName, json.RawMessage(`{}`), "audit:close")
+	if !closed.Success {
+		t.Fatal("close failed")
+	}
+}
