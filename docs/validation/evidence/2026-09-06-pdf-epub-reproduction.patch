+package runtime
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAuditPDFEPUBProductionParse(t *testing.T) {
+	const cwd = "/var/tmp/noema-suite-run-20260905/pdf-epub"
+	for _, test := range []struct {
+		name, want string
+		valid      bool
+	}{{"資料.pdf", "First audit page\n\nSecond audit page", true}, {"資料.epub", "# Audit book\n\nSecond café 日本語\n\nFirst café 日本語", true}, {"broken.pdf", "", false}} {
+		t.Run(test.name, func(t *testing.T) {
+			before, err := os.ReadFile(filepath.Join(cwd, test.name))
+			if err != nil {
+				t.Fatal(err)
+			}
+			args, _ := json.Marshal(map[string]any{"path": test.name, "max_chars": 20000})
+			result, err := parseConversationFile(t.Context(), cwd, args)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if test.valid {
+				if result.Status != "converted" || result.Content == nil || *result.Content != test.want || result.Truncated {
+					t.Fatalf("parse status=%s content=%v", result.Status, result.Content)
+				}
+			} else if result.Status != "failed" || result.Error == nil || result.Content != nil {
+				t.Fatal("malformed PDF did not fail explicitly")
+			}
+			after, err := os.ReadFile(filepath.Join(cwd, test.name))
+			if err != nil || string(after) != string(before) {
+				t.Fatal("source bytes changed", err)
+			}
+		})
+	}
+}
