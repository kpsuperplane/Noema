+package runtime
+
+import (
+	"context"
+	"github.com/kpsuperplane/noema/internal/provider"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/kpsuperplane/noema/internal/home"
+	"github.com/kpsuperplane/noema/internal/store"
+)
+
+func TestAuditACPStartFailureRecovery(t *testing.T) {
+	chat, db, _ := chatFixture(t)
+	ctx := t.Context()
+	now := time.Now()
+	policy, err := db.TaskExecutionPolicy(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	policy.MaxAutomaticRetries = 0
+	if _, err = db.UpdateTaskExecutionPolicy(ctx, policy); err != nil {
+		t.Fatal(err)
+	}
+	missing := filepath.Join(t.TempDir(), "missing-acp")
+	agent, err := db.CreateAcpAgent(ctx, "Audit missing ACP", missing, nil, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id, _ := store.NewTaskID()
+	task, err := db.CreateTask(ctx, id, "Audit ACP recovery", "correlation:audit:acp", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const progress = "# Task\n\nPreserve progress café 日本語.\n"
+	if _, err = home.CreatePendingTaskDocument(chat.home, id, progress); err != nil {
+		t.Fatal(err)
+	}
+	if err = home.CommitTaskDocument(chat.home, id); err != nil {
+		t.Fatal(err)
+	}
+	if err = home.WriteTaskFile(chat.home, id, "progress.txt", "Saved café 日本語"); err != nil {
+		t.Fatal(err)
+	}
+	updated, err := db.UpdateInboxTask(ctx, id, task.Revision, task.Generation, store.TaskUpdate{ExecutorAgentID: &agent.AgentID}, runtimeTaskCommand("update_task", "audit-acp"), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.QueueTask(ctx, id, updated.Task.Revision, task.Generation, runtimeTaskCommand("queue_task", "audit-acp"), now); err != nil {
+		t.Fatal(err)
+	}
+	_, planner, found, err := db.ClaimTaskExecution(ctx, now)
+	if err != nil || !found {
+		t.Fatal("planner unavailable", err)
+	}
+	if err = db.StartTaskExecution(ctx, planner.ID, planner.Generation, now); err != nil {
+		t.Fatal(err)
+	}
+	if err = db.FinishTaskPlanning(ctx, planner.ID, planner.Generation, "simple", now); err != nil {
+		t.Fatal(err)
+	}
+	current, run, found, err := db.ClaimTaskExecution(ctx, now)
+	if err != nil || !found || run.Kind != "executor" {
+		t.Fatal("executor unavailable", err)
+	}
+	execution := &TaskExecution{database: db, root: chat.home}
+	execution.execute(ctx, current, run)
+	waiting, err := db.Task(ctx, id)
+	if err != nil || waiting.StageKey != "waiting" {
+		t.Fatal("failure did not enter recovery", err)
+	}
+	gate, err := db.TaskGate(ctx, waiting.ActiveGateID)
+	if err != nil || gate.Kind != "recovery" || gate.RetryRunKind == nil || *gate.RetryRunKind != "executor" || gate.Prompt == "" {
+		t.Fatal("recovery lacks retry or diagnostic", err)
+	}
+	for path, want := range map[string]string{"TASK.md": progress, "progress.txt": "Saved café 日本語"} {
+		got, err := home.ReadTaskFile(chat.home, id, path)
+		if err != nil || got != want {
+			t.Fatal("progress changed", path, err)
+		}
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	corrected, err := db.UpdateAcpAgent(ctx, agent.AgentID, agent.ConnectionRevision, "Corrected ACP", executable, []string{"-test.run=^TestTaskACPAgentProcess$", "--", "NOEMA_TASK_ACP_AGENT", filepath.Join(t.TempDir(), "attempt")}, true, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	command := runtimeTaskCommand("answer_task", "audit-acp-retry")
+	for range 2 {
+		if _, err = db.ResolveTaskGate(ctx, id, gate.ID, waiting.Revision, waiting.Generation, "Retry corrected ACP", "retry", nil, command, time.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	retryTask, retry, found, err := db.ClaimTaskExecution(ctx, time.Now())
+	if err != nil || !found || retry.Kind != "executor" || retry.Generation != run.Generation {
+		t.Fatal("retry identity differs", err)
+	}
+	if retry.AcpLaunch == nil || retry.AcpLaunch.Command != executable || retry.AcpLaunch.ConnectionRevision != corrected.ConnectionRevision {
+		t.Fatal("retry retained obsolete ACP launch")
+	}
+	runs, err := db.TaskRuns(ctx, id, 10)
+	if err != nil || len(runs) != 3 {
+		t.Fatal("duplicate retry run", err)
+	}
+	execution.execute(ctx, retryTask, retry)
+	approvalTask, err := db.Task(ctx, id)
+	if err != nil || approvalTask.StageKey != "waiting" {
+		t.Fatal("corrected process did not request approval", err)
+	}
+	approval, err := db.TaskGate(ctx, approvalTask.ActiveGateID)
+	if err != nil || approval.Kind != "approval" {
+		t.Fatal("approval missing", err)
+	}
+	decision := "approved"
+	if _, err = db.ResolveTaskGate(ctx, id, approval.ID, approvalTask.Revision, approvalTask.Generation, "Allow exact audit action", "answer", &decision, runtimeTaskCommand("answer_task", "audit-acp-approve"), time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	approvedTask, approvedRun, found, err := db.ClaimTaskExecution(ctx, time.Now())
+	if err != nil || !found || approvedRun.Kind != "executor" {
+		t.Fatal("approved executor missing", err)
+	}
+	execution.execute(ctx, approvedTask, approvedRun)
+	reviewTask, reviewRun, found, err := db.ClaimTaskExecution(ctx, time.Now())
+	if err != nil || !found || reviewRun.Kind != "reviewer" {
+		t.Fatal("review missing", err)
+	}
+	generator := generatorFunc(func(_ context.Context, request provider.GenerateRequest, _ func(provider.StreamEvent)) (provider.GenerationResult, error) {
+		if taskRequestRole(request.Tools) != "reviewer" {
+			t.Error("unexpected provider role")
+		}
+		return taskToolResult("audit-acp-review", taskFinishReview, map[string]any{"decision": "approve", "feedback": "Recovered ACP result is correct.", "notify_human": false}), nil
+	})
+	execution.openRouter = generator
+	execution.codex = generator
+	execution.openAI = generator
+	execution.execute(ctx, reviewTask, reviewRun)
+	done, err := db.Task(ctx, id)
+	if err != nil || done.StageKey != "done" || done.Generation != task.Generation {
+		t.Fatal("recovered Task did not complete", err)
+	}
+	for path, want := range map[string]string{"RESULT.md": "ACP result.\n", "progress.txt": "Saved café 日本語"} {
+		got, err := home.ReadTaskFile(chat.home, id, path)
+		if err != nil || got != want {
+			t.Fatal("final file differs", path, err)
+		}
+	}
+	runs, err = db.TaskRuns(ctx, id, 10)
+	if err != nil || len(runs) != 5 {
+		t.Fatal("unexpected final runs", err)
+	}
+
+}
