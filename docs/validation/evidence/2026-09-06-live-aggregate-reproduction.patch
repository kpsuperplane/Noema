+package notification
+
+import (
+	"fmt"
+	"github.com/kpsuperplane/noema/internal/home"
+	"github.com/kpsuperplane/noema/internal/store"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestAuditLiveActivityAggregatesThreeTasks(t *testing.T) {
+	ctx, now := t.Context(), time.Now()
+	paths, err := home.FromRoot(filepath.Join(t.TempDir(), "home"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	root, err := paths.Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Close()
+	db, err := store.Open(ctx, paths.Database())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	client := seedAPNSClient(t, db)
+	service, err := New(paths, db, "https://noema.example")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids, runs := []string{}, []string{}
+	for i := 1; i <= 3; i++ {
+		id, run := fmt.Sprintf("task:%032d", i), fmt.Sprintf("run:%032d", i)
+		if _, err := db.CreateTask(ctx, id, fmt.Sprintf("Audit Task %d", i), fmt.Sprintf("correlation:audit:aggregate:%d", i), now); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := db.StartTask(ctx, id, run, now.Add(time.Duration(i)*time.Second)); err != nil {
+			t.Fatal(err)
+		}
+		ids = append(ids, id)
+		runs = append(runs, run)
+	}
+	if err := db.RegisterClientLiveActivities(ctx, client, []byte("audit-start-token"), store.APNSDevelopment, nil, now); err != nil {
+		t.Fatal(err)
+	}
+	apply := func(count int) {
+		t.Helper()
+		state, err := service.liveProjection(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if count == 0 {
+			if state != nil {
+				t.Fatal("completed Tasks remain active")
+			}
+		} else if state == nil || state.Content["activeTaskCount"] != count {
+			t.Fatal("aggregate active count differs")
+		}
+		targets, err := db.LiveActivityTargets(ctx)
+		if err != nil || len(targets) != 1 {
+			t.Fatal("expected one activity target")
+		}
+		if err := service.applyLiveProjection(ctx, targets[0], state); err != nil {
+			t.Fatal(err)
+		}
+	}
+	claim := func(event store.LiveActivityEvent) *store.LiveActivityDelivery {
+		t.Helper()
+		value, err := db.ClaimDueLiveActivityDelivery(ctx, time.Now().Add(time.Minute))
+		if err != nil || value == nil || value.Event != event {
+			t.Fatal("unexpected activity delivery")
+		}
+		return value
+	}
+	apply(3)
+	start := claim(store.LiveActivityStart)
+	activityID := start.ActivityID
+	if err := db.FinishLiveActivityDelivery(ctx, *start, store.APNSDelivered, "", "audit-start", time.Now()); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := db.RegisterClientLiveActivityUpdate(ctx, client, activityID, []byte("audit-update-token"), time.Now()); err != nil || !changed {
+		t.Fatal("update registration failed")
+	}
+	for index := 2; index >= 0; index-- {
+		if _, err := db.FinishTask(ctx, ids[index], runs[index], store.TaskCompleted, time.Now()); err != nil {
+			t.Fatal(err)
+		}
+		apply(index)
+		event := store.LiveActivityUpdate
+		if index == 0 {
+			event = store.LiveActivityEnd
+		}
+		delivery := claim(event)
+		if delivery.ActivityID != activityID {
+			t.Fatal("completion created a different activity")
+		}
+		content := delivery.Payload["aps"].(map[string]any)["content-state"].(map[string]any)
+		if index > 0 {
+			if fmt.Sprint(content["activeTaskCount"]) != fmt.Sprint(index) || content["focusTaskId"] == ids[index] {
+				t.Fatal("completed Task remains in active payload")
+			}
+		} else if content["phase"] != "completed" {
+			t.Fatal("final activity is not completed")
+		}
+		if err := db.FinishLiveActivityDelivery(ctx, *delivery, store.APNSDelivered, "", "audit-result", time.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if extra, err := db.ClaimDueLiveActivityDelivery(ctx, time.Now().Add(time.Hour)); err != nil || extra != nil {
+		t.Fatal("duplicate activity delivery")
+	}
+	t.Log("Three Tasks share one activity; active counts decrease from three to zero; completion removes focus and ends the same activity without duplicate delivery")
+}
