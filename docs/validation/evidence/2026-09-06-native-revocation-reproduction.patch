+package store
+
+import (
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestAuditNativeRevocationKeepsOtherClientAfterRestart(t *testing.T) {
+	ctx, now := t.Context(), time.Now().Unix()
+	path := filepath.Join(t.TempDir(), "noema.sqlite3")
+	db, err := Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = db.Close() }()
+	firstAccess, firstRefresh := seedNativeFamily(t, db, testNativeClient, "5", now)
+	secondClient := "noema-ios:abcdefghijklmnop"
+	secondAccess, secondRefresh := seedNativeFamily(t, db, secondClient, "6", now)
+	if _, changed, err := db.RevokeNativeOAuthClient(ctx, testNativeClient, now+1); err != nil || !changed {
+		t.Fatal("client revocation failed")
+	}
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db, err = Open(ctx, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, active, err := db.ActiveNativeOAuthAccess(ctx, firstAccess, now+2); err != nil || active {
+		t.Fatal("revoked access accepted after restart")
+	}
+	first, err := db.NativeOAuthRefreshGrant(ctx, firstRefresh, nil, now+2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.State == "active" || first.State == "retryable" {
+		t.Fatal("revoked refresh remains usable")
+	}
+	access, active, err := db.ActiveNativeOAuthAccess(ctx, secondAccess, now+2)
+	if err != nil || !active || access.ClientID != secondClient {
+		t.Fatal("unrelated client lost access")
+	}
+	second, err := db.NativeOAuthRefreshGrant(ctx, secondRefresh, nil, now+2)
+	if err != nil || second.State != "active" {
+		t.Fatal("unrelated refresh lost access")
+	}
+	rotation := NativeOAuthRotation{AccessHash: testDigest("audit-next-access"), RefreshHash: testDigest("audit-next-refresh"), IssuedAt: now + 3, AccessExpires: now + 903, IdleExpiresAt: now + 30*24*60*60}
+	if result, err := db.RotateNativeOAuthRefresh(ctx, secondRefresh, rotation, now+3); err != nil || result.State != "rotated" {
+		t.Fatal("unrelated client cannot refresh")
+	}
+	if _, active, err := db.ActiveNativeOAuthAccess(ctx, rotation.AccessHash, now+4); err != nil || !active {
+		t.Fatal("refreshed unrelated access rejected")
+	}
+	t.Log("Revoked access and refresh remain denied after restart; the other client retains access and completes refresh")
+}
